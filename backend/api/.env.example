# 复制为 .env 后填写（不要提交 .env）
APP_ENV=development
APP_VERSION=development
GLOBEMIND_GENERATED_ASSET_ROOT=/root/data/web/generated-assets
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=web_runtime
GLOBEMIND_DB_PASSWORD_FILE=/root/data/secrets/globemind/web_runtime.password
DB_NAME=news
DB_SSLMODE=verify-full
GLOBEMIND_ALLOW_PRIVATE_SCRAM_TRANSPORT=0

# 用户自带 API Key 的数据库加密密钥（Fernet；必须与 JWT_SECRET_KEY 分离）
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
USER_API_KEYS_ENCRYPTION_KEY=
# 轮换期间可填旧密钥，多个密钥用英文逗号分隔；完成重加密后清空
USER_API_KEYS_DECRYPTION_KEYS=

# DeepSeek / LLM API
DEEPSEEK_API_KEY=
PUBLIC_DEEPSEEK_API_KEY=
PUBLIC_DEEPSEEK_BASE_URL=https://api.deepseek.com
PUBLIC_DEEPSEEK_MODEL=deepseek-v4-flash

# Hermes / OpenAI-compatible assistant API
# 留空时数据助手会回退本机 vLLM: http://127.0.0.1:8004/v1
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=
HERMES_TIMEOUT_SEC=180
HERMES_TOOL_TIMEOUT_SEC=45
HERMES_TOOL_CONCURRENCY=3
HERMES_MAX_TOKENS=1024
HERMES_MEMORY_MODEL=
HERMES_WEB_SEARCH_API_KEY=
HERMES_WEB_SEARCH_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
HERMES_WEB_SEARCH_MODEL=deepseek-v4-flash
HERMES_WEB_SEARCH_TIMEOUT_SEC=60
HERMES_WEB_SEARCH_MAX_TOKENS=900
HERMES_WEB_SEARCH_SUMMARY_CHARS=1800
HERMES_FALLBACK_BASE_URL=http://127.0.0.1:8004
HERMES_FALLBACK_MODEL=qwen2.5-7b-awq

# Hermes Image Generation（图片生成 tool；公共账号优先，用户个人配置作为 fallback）
HERMES_IMAGE_BACKEND=openai
HERMES_IMAGE_OPENAI_API_KEY=
HERMES_IMAGE_OPENAI_BASE_URL=https://img-cn.65535.space/v1
HERMES_IMAGE_OPENAI_MODEL=gpt-image-2
HERMES_IMAGE_TIMEOUT_SEC=600

# Frontend
VITE_API_BASE_URL=http://localhost:8088

# 管理员身份由 app_user 数据库记录及 role=admin 决定；生产登录只校验数据库密码
ADMIN_USER=admin
# 仅用于显式开启的本地开发兼容登录；生产环境永不使用
ADMIN_PASSWORD=
ALLOW_DEV_ADMIN_PASSWORD_LOGIN=0
# 仅开发迁移期可接受升级前签发的 token；生产环境永不接受
ALLOW_DEV_LEGACY_AUTH_TOKENS=0

# 可选的一次性默认用户 seed 口令；与 ADMIN_PASSWORD 完全独立
# 生产部署完成 seed 后应清空，运行期不需要保留
SEED_DEFAULT_USERNAME=admin
SEED_DEFAULT_USER_PASSWORD=

# Request and workspace guardrails
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HTTP_MAX_REQUEST_BYTES=8388608
HTTP_MAX_AI_REQUEST_BYTES=2097152
HTTP_MAX_PROXY_REQUEST_BYTES=2097152
HTTP_MAX_PROXY_HTML_BYTES=4194304
WORKSPACE_UPLOAD_MAX_FILES=20
WORKSPACE_UPLOAD_MAX_FILE_BYTES=26214400
WORKSPACE_UPLOAD_MAX_REQUEST_BYTES=104857600
WORKSPACE_MAX_BYTES=1073741824
WORKSPACE_USER_MAX_BYTES=5368709120
WORKSPACE_MAX_COUNT_PER_USER=50
WORKSPACE_DISK_MIN_FREE_BYTES=1073741824
ASSISTANT_SCHEDULE_SHUTDOWN_TIMEOUT_SEC=30
AUTH_RATE_LIMIT_REQUESTS=10
REGISTRATION_RATE_LIMIT_REQUESTS=5
AI_RATE_LIMIT_REQUESTS=30
UPLOAD_RATE_LIMIT_REQUESTS=10
MUTATION_RATE_LIMIT_REQUESTS=60
HEARTBEAT_RATE_LIMIT_REQUESTS=6
HEARTBEAT_RATE_LIMIT_WINDOW_SECONDS=60
OPS_HEARTBEAT_MAX_CLIENTS=10000

# SMTP（可选）
SMTP_ENABLED=false
