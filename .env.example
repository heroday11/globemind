# 复制为 .env 后填写（不要提交 .env）
# PostgreSQL — globemind 主库
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=news

# PostgreSQL — news 新闻库（PG_* 是 db.py 的别名）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=news

# Milvus（可选：未配置时回退 sklearn 聚类）
GLOBEMIND_MILVUS_URI=data/milvus_local.db
