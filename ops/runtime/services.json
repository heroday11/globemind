    {
      "id": "daily_ingest",
      "name": "Daily news discovery/extract/load loop",
      "kind": "pipeline",
      "owner": "data-ingestion",
      "criticality": "high",
      "check_interval_seconds": 300,
      "dependencies": [
        {"service": "proxy_pool", "required": false}
      ],
      "external_dependencies": ["historical-source-websites", "postgres-news"],
      "controller": {
        "type": "shell-script",
