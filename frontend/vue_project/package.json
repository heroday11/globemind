{
  "name": "vue_project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:main": "vite",
    "build:financial-terminal": "npm run build --prefix ../financial-terminal",
    "build": "node scripts/build-release.mjs",
    "build:main-only": "VITE_BUILD_ID=${VITE_BUILD_ID:-local} vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --skipLibCheck --module ESNext --moduleResolution Bundler --target ES2022 --lib ES2022,DOM auto-imports.d.ts components.d.ts",
    "test": "npm run test:features",
    "test:assistant": "node --test tests/assistant-feature.test.mjs",
    "test:display-preferences": "node --test tests/display-preferences-feature.test.mjs",
    "test:ground-news": "node --test tests/ground-news-feature.test.mjs",
    "test:governance": "node --test tests/public-governance-feature.test.mjs",
    "test:navigation-boundary": "node --test tests/navigation-boundary-feature.test.mjs",
    "test:story-graph": "node --test tests/story-graph-feature.test.mjs",
    "test:features": "node --test tests/*-feature.test.mjs",
    "lint": "eslint src scripts vite.config.js eslint.config.js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@globemind/shared": "1.0.0",
    "@antv/g6": "^5.1.1",
    "@element-plus/icons-vue": "^2.3.2",
    "3d-force-graph": "^1.80.0",
    "axios": "^1.13.2",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.4",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.2.0",
    "pinia": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "sharp": "^0.34.5",
    "three": "^0.183.2",
    "vis-network": "^9.1.6",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "abortcontroller-polyfill": "^1.7.8",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "~10.4.0",
    "globals": "^16.3.0",
    "less": "^4.4.2",
    "less-loader": "^12.3.0",
    "postcss": "^8.5.3",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.17",
    "terser": "^5.49.0",
    "typescript": "~7.0.2",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.7",
    "vite-plugin-vue-devtools": "^8.0.5",
    "whatwg-fetch": "^3.6.20"
  }
}
